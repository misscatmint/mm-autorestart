import os


def resolveEnvPath(env, folder=None):
    if env in os.environ:
        path = os.environ[env]
        if os.path.isdir(path):
            return path
    elif folder is not None:
        head = os.getcwd()
        oldhead = None
        while head != None and head != oldhead:
            path = os.path.join(head, folder)
            if os.path.isdir(path):
                return path
            oldhead = head
            head, tail = os.path.split(head)
    return None


def resolveMMSRoot():
    path = builder.options.mms_path
    if not path:
        path = resolveEnvPath("MMSOURCE", "metamod-source")
    if not path or not os.path.isdir(path):
        raise Exception("Could not find a source copy of Metamod:Source")
    return os.path.abspath(os.path.normpath(path))


mms_root = resolveMMSRoot()

hl2sdk_manifests_root = builder.options.hl2sdk_manifests or os.path.join(
    mms_root, "hl2sdk-manifests"
)
if not os.path.isdir(hl2sdk_manifests_root):
    raise Exception("Could not find a source copy of HL2SDK manifests")

SdkHelpers = builder.Eval(
    os.path.join(hl2sdk_manifests_root, "SdkHelpers.ambuild"), {"Project": "metamod"}
)


class MMSPluginConfig(object):
    def __init__(self):
        self.sdk_manifests = []
        self.sdk_targets = []
        self.tasks = []
        self.all_targets = []
        self.metadata = {
            "name": "autorestart",
            "alias": "autorestart",
        }

        for arch in builder.options.targets.split(","):
            self.all_targets.append(builder.DetectCxx(target_arch=arch))

    def findSdkPath(self, sdk_name):
        dir_name = "hl2sdk-{}".format(sdk_name)
        if builder.options.hl2sdk_root:
            sdk_path = os.path.abspath(
                os.path.join(builder.options.hl2sdk_root, dir_name)
            )
            if os.path.exists(sdk_path):
                return sdk_path
        return resolveEnvPath("HL2SDK{}".format(sdk_name.upper()), dir_name)

    def detectSDKs(self):
        SdkHelpers.find_sdk_path = self.findSdkPath
        SdkHelpers.findSdks(builder, self.all_targets, ["csgo"])
        self.sdk_manifests = SdkHelpers.sdk_manifests
        self.sdk_targets = SdkHelpers.sdk_targets

    def configure(self):
        for cxx in self.all_targets:
            self.configureCXX(cxx)

    def configureCXX(self, cxx):
        if cxx.behavior != "gcc" or cxx.target.platform != "linux":
            raise Exception(
                "Only Linux GCC/Clang builds are supported"
            )

        cxx.defines += [
            "stricmp=strcasecmp",
            "_stricmp=strcasecmp",
            "_snprintf=snprintf",
            "_vsnprintf=vsnprintf",
            "HAVE_STDINT_H",
            "GNUC",
            "LINUX",
            "_LINUX",
            "POSIX",
            "_FILE_OFFSET_BITS=64",
            "PIC",
        ]
        cxx.cflags += [
            "-pipe",
            "-fno-strict-aliasing",
            "-Wall",
            "-Wno-sign-compare",
            "-Wno-uninitialized",
            "-Wno-unused",
            "-Wno-switch",
            "-Wno-unknown-pragmas",
            "-Wno-dangling-else",
            "-msse",
            "-fPIC",
            "-fvisibility=hidden",
            "-pthread",
        ]
        cxx.cxxflags += [
            "-std=c++17",
            "-fvisibility-inlines-hidden",
            "-fno-exceptions",
            "-fno-threadsafe-statics",
            "-Wno-non-virtual-dtor",
            "-Wno-overloaded-virtual",
            "-Wno-register",
            "-Wno-delete-non-virtual-dtor",
            "-fPIC",
        ]
        if cxx.family == "gcc":
            cxx.cflags += ["-mfpmath=sse"]
            cxx.linkflags += ["-static-libgcc"]
        elif cxx.family == "clang":
            cxx.cxxflags += [
                "-Wno-implicit-exception-spec-mismatch",
                "-Wno-expansion-to-defined",
                "-Wno-inconsistent-missing-override",
                "-Wno-deprecated-register",
                "-Wno-implicit-int-float-conversion",
                "-Wno-tautological-overlap-compare",
            ]
            cxx.linkflags += ["-lgcc_eh"]

        # Metamod dlcloses plugins during shutdown.
        # The quit watchdog thread must outlive that, so the .so is never unmapped.
        cxx.linkflags += ["-pthread", "-ldl", "-Wl,-z,nodelete", "-Wl,-z,notext"]

        if builder.options.opt == "1":
            cxx.defines += ["NDEBUG"]
            cxx.cflags += ["-O3"]
        if builder.options.debug == "1":
            cxx.defines += ["DEBUG", "_DEBUG"]
            cxx.cflags += ["-g3"]
        cxx.cflags += ["-fno-omit-frame-pointer"]

    def HL2Library(self, context, compiler, project, sdk):
        binary = project.Configure(
            compiler,
            "{0}.{1}".format(project.name, sdk["extension"]),
            "{0} {1}".format(sdk["name"], compiler.target.arch),
        )
        cxx = binary.compiler

        cxx.cxxincludes += [
            os.path.join(context.currentSourcePath, "src"),
            os.path.join(mms_root, "core"),
            os.path.join(mms_root, "core", "sourcehook"),  # MM:S 1.12
            os.path.join(mms_root, "third_party", "khook", "include"),  # MM:S 2.0
        ]

        for other_sdk in self.sdk_manifests:
            cxx.defines += ["SE_{}={}".format(other_sdk["define"], other_sdk["code"])]

        SdkHelpers.configureCxx(context, binary, sdk)

        return binary


MMSPlugin = MMSPluginConfig()
MMSPlugin.detectSDKs()
MMSPlugin.configure()

builder.Build(["AMBuilder", "PackageScript"], {"MMSPlugin": MMSPlugin})
